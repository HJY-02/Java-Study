class ParenCat{
	public String breed="샴고양이";
	void eat() {
		System.out.println("먹이를 먹다");
	}
}
class BabyCat extends ParenCat{
	public String color="초콜릿색";
	void meow() {
		System.out.println("야옹하고 울다.");
	}
}
public class chap08_1 {
	public static void main(String[] args) {
		BabyCat catobj=new BabyCat();
		System.out.println("품종: "+catobj.breed);
		System.out.println("품종: "+catobj.color);
		
		catobj.eat();
		catobj.meow();
	}
}
